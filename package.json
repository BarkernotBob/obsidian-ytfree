{
  "name": "obsidian-ytfree",
  "version": "0.1.0",
  "description": "Ad-free YouTube playback inside Obsidian notes",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test \"tests/*.test.ts\"",
    "smoke": "node tools/smoke.mjs",
    "check": "npm run test && npm run build",
    "smoke:full": "node tools/smoke.mjs --full",
    "lint": "eslint src manifest.json package.json LICENSE",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "obsidian": "^1.13.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "hls.js": "^1.6.16"
  }
}
