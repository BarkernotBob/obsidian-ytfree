{
  "name": "obsidian-ytfree",
  "version": "0.1.0",
  "description": "Ad-free YouTube playback inside Obsidian notes",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test \"tests/*.test.ts\"",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run test && npm run check:pages && npm run build",
    "check:pages": "node scripts/check-pages.mjs",
    "smoke:full": "node scripts/smoke.mjs --full",
    "lint": "eslint src manifest.json package.json LICENSE",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [],
  "author": "BarkernotBob",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "happy-dom": "^21.0.4",
    "obsidian": "^1.14.4",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "hls.js": "^1.7.4"
  }
}
